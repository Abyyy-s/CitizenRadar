<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core OpenCvSharp4 library (includes DNN module for ONNX inference) -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />

    <!-- Native runtime binaries — Windows and Linux x64 with full VideoIO, HighGUI, and DNN support -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.unofficial.runtime.linux-x64" Version="4.10.0.20241108" />

    <!-- GPU ONNX Runtime Inference -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.31.1" />
  </ItemGroup>

  <!-- Copy ONNX models and sample data to the output directory -->
  <ItemGroup>
    <None Update="models/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="data/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
